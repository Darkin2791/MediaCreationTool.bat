<Window x:Class="OfferBuilder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конструктор коммерческих предложений" Height="720" Width="1200">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Новый" Command="{Binding NewOfferCommand}"/>
            <Button Content="Сохранить" Command="{Binding SaveCommand}"/>
            <Button Content="Предпросмотр" Command="{Binding PreviewCommand}"/>
            <Button Content="Экспорт PDF" Command="{Binding ExportPdfCommand}"/>
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Список предложений" Margin="8">
                <ListBox ItemsSource="{Binding Offers}" SelectedItem="{Binding SelectedOffer}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Number}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Title}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <TabControl Grid.Column="1" Margin="8">
                <TabItem Header="Общие">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Заголовок"/>
                        <TextBox Grid.Row="1" Text="{Binding SelectedOffer.Title, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Row="2" Text="{Binding SelectedOffer.Subtitle, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Секции">
                    <DataGrid ItemsSource="{Binding Sections}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding SortOrder}"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding SectionType}"/>
                            <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}"/>
                            <DataGridCheckBoxColumn Header="Видимый" Binding="{Binding IsVisible}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Предпросмотр">
                    <StackPanel Margin="8">
                        <TextBlock Text="Путь к предпросмотру:" FontWeight="Bold"/>
                        <TextBox Text="{Binding PreviewPath}" IsReadOnly="True"/>
                        <TextBlock Text="Для MVP предпросмотр формируется в PDF с тем же шаблоном, что и экспорт." Margin="0,8,0,0"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
